<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Action: فتح الـ Wizard                                      -->
    <!-- ============================================================ -->
    <record id="action_clear_data_wizard" model="ir.actions.act_window">
        <field name="name">Clean Database</field>
        <field name="res_model">clear.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!--  Menus - جوه Settings > Administration                       -->
    <!-- ============================================================ -->
    <menuitem id="menu_data_purger_root"
              name="Odoo Data Cleaner Pro (Odoo 19)"
              parent="base.menu_administration"
              groups="base.group_system"
              sequence="100"/>

    <menuitem id="menu_clear_wizard_action"
              name="Clean Database"
              parent="menu_data_purger_root"
              action="action_clear_data_wizard"
              groups="base.group_system"
              sequence="1"/>

</odoo>