<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clear_data_wizard_form" model="ir.ui.view">
        <field name="name">clear.data.wizard.form</field>
        <field name="model">clear.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Clear Data">
              <div class="alert alert-danger">
    ⚠️ This tool permanently deletes data. Use only in test or staging environments.
</div>
                <group>
                    <field name="all_data" widget="boolean_toggle"/>
                </group>
                <group>
                    <group>
                        <field name="sale"/>
                        <field name="purchase"/>
                        <field name="inventory"/>
                    </group>
                    <group>
                        <field name="projects"/>
                        <field name="contacts"/>
                    </group>
                </group>
                <footer>
                    <button name="action_clear_data" string="Clear Selected Data" type="object" class="btn-danger" confirm="Are you sure? This cannot be undone!"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_clear_data_wizard" model="ir.actions.act_window">
        <field name="name">Mass Data Purger</field>
        <field name="res_model">clear.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>